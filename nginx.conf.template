# Redirect da HTTP a HTTPS
server {
    listen 80;
    server_name ${HOST_IP} ${HOST_DOMAIN};

    # Redirect tutte le richieste a HTTPS
    return 301 https://$host$request_uri;
}

# Server HTTPS principale
server {
    listen 443 ssl;
    server_name ${HOST_IP} ${HOST_DOMAIN};

    # Configurazione SSL
    ssl_certificate /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers 'ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256';
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;

    root /usr/share/nginx/html;
    index index.html;

    # Aumenta i buffer per gestire file grandi
    client_max_body_size 100M;
    client_body_buffer_size 50M;
    proxy_buffers 16 16k;
    proxy_buffer_size 32k;

    # Timeout generali
    proxy_connect_timeout 120s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
    send_timeout 120s;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 10240;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/json;
    gzip_disable "MSIE [1-6]\.";

    # ================================================
    # WIKI.JS PROXY
    # ================================================

    # Main wiki location
    location /wiki {
        proxy_pass http://wiki:3000;

        # Headers standard proxy
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        # Headers per client IP reale
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        # Timeout
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Wiki.js assets (CSS, JS, immagini)
    location /wiki/_assets {
        proxy_pass http://wiki:3000/_assets;

        # Cache statico per performance
        proxy_cache_valid 200 1d;
        proxy_cache_bypass $http_upgrade;

        # Headers caching
        add_header Cache-Control "public, max-age=86400";

        # Headers proxy standard
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Wiki.js uploads e altri file statici
    location /wiki/uploads {
        proxy_pass http://wiki:3000/uploads;

        # No cache per uploads (possono cambiare)
        proxy_cache_bypass 1;
        proxy_no_cache 1;

        # Headers proxy standard
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ================================================
    # END WIKI.JS PROXY
    # ================================================

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache control for static assets
    location /assets {
        expires 1y;
        add_header Cache-Control "public, no-transform";
    }

    # Route specifica per email preview con timeout estesi
    location ~ ^/api/email-preview/ {
        proxy_pass https://${HOST_IP}:${API_HTTPS_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Timeout estesi per email preview (5 minuti)
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        send_timeout 300s;

        # Disabilita buffering per streaming
        proxy_buffering off;
        proxy_request_buffering off;

        # Buffer più grandi per response
        proxy_busy_buffers_size 32k;
        proxy_temp_file_write_size 64k;
    }

    # Route per email info (veloce, timeout standard)
    location ~ ^/api/email-info/ {
        proxy_pass https://${HOST_IP}:${API_HTTPS_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout standard per info rapide
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    # Route per download allegati con timeout estesi
    location ~ ^/api/attachments/[0-9]+/download$ {
        proxy_pass https://${HOST_IP}:${API_HTTPS_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout estesi per download file grandi
        proxy_connect_timeout 180s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;

        # Streaming senza buffer
        proxy_buffering off;
    }

    # Route per upload allegati con timeout estesi
    location ~ ^/api/attachments/.*/upload$ {
        proxy_pass https://${HOST_IP}:${API_HTTPS_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout estesi per upload
        proxy_connect_timeout 180s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        client_body_timeout 300s;

        # Buffer per upload grandi
        client_body_buffer_size 50M;
        proxy_request_buffering off;
    }

    # API Proxy generale (tutte le altre route)
    location /api/ {
        proxy_pass https://${HOST_IP}:${API_HTTPS_PORT}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Timeout standard per API generali
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-XSS-Protection "1; mode=block";
    add_header X-Content-Type-Options "nosniff";
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Referrer-Policy "no-referrer-when-downgrade";
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://${HOST_IP}:${API_HTTPS_PORT}";
}
